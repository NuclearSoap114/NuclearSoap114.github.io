---
import { Icon } from 'astro-icon/components';
import { homePicks } from '../data/home-picks';
import { getNotes,getAlgorithmCategories,getNoteTopics,categoryUrl,noteUrl,topicUrl } from '../utils/notes';
import '../styles/home.css';
const notes=await getNotes();
const categories=getAlgorithmCategories(notes);
const topics=getNoteTopics(notes);
const courseTopics=topics.filter(topic=>topic.id!=='algorithms');
const picks=homePicks.map(pick=>{
 const note=notes.find(n=>n.data.title===pick.title);
 if(!note)throw new Error(`Missing home pick: ${pick.title}`);
 return {...pick,url:noteUrl(note.slug)};
});
const [lead,...rest]=picks;
---
<div class="home-feed">
 <header class="home-intro card-base">
  <div class="home-intro-copy"><span class="home-eyebrow">NUCLEARSOAP / NOTEBOOK</span><h1>NuclearSoap 的笔记本</h1><p>算法、题解和课程笔记，按主题放在这里。</p><div class="home-intro-topics"><a href={topicUrl('algorithms')}>算法与竞赛 <Icon name="material-symbols:arrow-forward-rounded"/></a><a href="#home-courses">课程笔记 <Icon name="material-symbols:arrow-downward-rounded"/></a></div></div>
  <a href="/notes/" class="home-all"><span class="home-notebook-count">{notes.length}<small>篇笔记 / {topics.length} 个主题</small></span><span class="home-all-link">打开目录 <Icon name="material-symbols:arrow-forward-rounded"/></span></a>
 </header>
 <section aria-labelledby="home-selected" class="home-selection">
  <div class="home-section-heading"><h2 id="home-selected">挑几篇看看</h2><span>从一个知识点开始</span></div>
  <div class="home-feature-grid">
   <a href={lead.url} class="home-feature home-article" data-home-article>
    <span class="home-article-meta">{lead.label}</span>
    <div class="home-feature-art" role="img" aria-label="矩阵快速幂：连续平方得到 T、T 的二次方、四次方和八次方，再组合 T 的八次方、四次方和一次方，得到 T 的十三次方。">
     <span class="home-art-label" aria-hidden="true">列状态 × 转移矩阵 <span class="home-demo-hint">悬停演示</span></span>
     <div class="home-color-grid" aria-hidden="true">{[0,1,2,0,1,2,0,1,2,0,1,2].map((color,i)=><span class={`color-${color} home-compute-step`} style={`--step-delay:${(i%4)*.65}s`}>{color}</span>)}</div>
     <div class="home-power-flow" aria-hidden="true">{['T','T²','T⁴','T⁸'].map((power,i)=><><b class="home-compute-step" style={`--step-delay:${i*.65}s`}>{power}</b>{i<3&&<span>→</span>}</>)}</div>
     <div class="home-demo-result home-power-result" style="--result-delay:2.6s" aria-hidden="true"><code>T¹³ = T⁸ · T⁴ · T</code><small>13 = 8 + 4 + 1</small></div>
    </div>
    <div class="home-feature-copy"><h3>{lead.title.includes('：')?<>{lead.title.split('：')[0]}：<span class="home-feature-subtitle">{lead.title.split('：').slice(1).join('：')}</span></>:lead.title}</h3><p>{lead.description}</p><span class="home-read">读这篇笔记 <Icon name="material-symbols:arrow-forward-rounded"/></span></div>
   </a>
   <div class="home-feature-aside">{rest.slice(0,2).map((pick,i)=><a href={pick.url} class={`home-article home-short home-tone-${i}`} data-home-article>
    <span class="home-article-meta">{pick.label}<span class="home-card-index" aria-hidden="true">0{i+2}</span></span>
    {pick.motif==='sieve' ? <div class="home-note-art home-number-art" role="img" aria-label="以欧拉函数为例进行莫比乌斯反演：对 12 的各个约数 d，累加 μ(d) 乘以 12 除以 d，得到 12 减 6 减 4 加 0 加 2 加 0，结果为 4。">
     <div class="home-demo-caption" aria-hidden="true"><span>约数 d / μ(d) · 12/d</span><span class="home-demo-hint">悬停演示</span></div>
     <div class="home-mobius-terms" aria-hidden="true">{[{d:1,v:'12'},{d:2,v:'−6'},{d:3,v:'−4'},{d:4,v:'0'},{d:6,v:'+2'},{d:12,v:'0'}].map((term,j)=><span class="home-compute-step" style={`--step-delay:${j*.42}s`}><small>{term.d}</small><b>{term.v}</b></span>)}</div>
     <div class="home-art-equations home-demo-result" style="--result-delay:2.52s" aria-hidden="true"><span>φ(12) = Σ μ(d) · 12/d</span><b>= 4</b></div>
    </div> : <div class="home-note-art home-xor-art" role="img" aria-label="二进制 101 与 011 按位异或：1 异或 0 为 1，0 异或 1 为 1，1 异或 1 为 0，得到 110。">
     <div class="home-bit-expression" aria-hidden="true">{['101','⊕','011','=','110'].map((part,j)=>part.length===3 ? <span class:list={['home-bit-word',{'is-result':j===4}]}>{part.split('').map((bit,k)=><b class:list={['home-compute-step',{'is-one':bit==='1','home-bit-result':j===4}]} style={`--step-delay:${k*.8}s`}>{bit}</b>)}</span> : <span class="home-bit-operator">{part}</span>)}</div>
     <div class="home-xor-caption" aria-hidden="true"><span class="home-demo-result" style="--result-delay:2.4s">相同为 0，不同为 1</span><span class="home-demo-hint">悬停演示</span></div>
    </div>}

    <h3>{pick.title}</h3><p>{pick.description}</p><span class="home-read">阅读全文 <Icon name="material-symbols:arrow-forward-rounded"/></span>
   </a>)}</div>
  </div>
 </section>
 <section class="home-category-section" aria-labelledby="home-algorithms">
  <div class="home-section-heading"><h2 id="home-algorithms">算法笔记</h2><a href={topicUrl('algorithms')}>查看目录 <Icon name="material-symbols:arrow-forward-rounded"/></a></div>
  <nav class="home-categories" aria-label="算法笔记分类">{categories.map((c,i)=><a href={categoryUrl(c.name)} class={`home-category home-category-${i}`}><div class="home-category-top"><Icon name={c.icon}/><span>{c.count} 篇</span></div><strong>{c.name}</strong><p>{c.description}</p></a>)}</nav>
 </section>
 <section aria-labelledby="home-more">
  <div class="home-section-heading"><h2 id="home-more">再翻几页</h2><span>算法之外，也有课程笔记</span></div>
  <div class="home-more-grid">{rest.slice(2).map(pick=><a href={pick.url} class={`home-article home-more home-${pick.motif}`} data-home-article><div class="home-mini-art" aria-hidden="true">{pick.motif==='xor'?<><code>101</code><span>⊕</span><code>011</code><span>=</span><code>110</code></>:pick.motif==='network'?<svg viewBox="0 0 240 64" fill="none"><path d="M12 52H228M12 52V8" stroke="currentColor" opacity=".25"/><path d="M20 49L42 45L64 37L86 21L108 17L130 13L152 9L158 33L180 29L202 25L224 21" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>:<><span>P(A | B)</span><span class="home-probability-arrow">↔</span><span>P(B | A)</span></>}</div><div class="home-more-copy"><span class="home-article-meta">{pick.label}</span><h3>{pick.title}</h3><p>{pick.description}</p><span class="home-read">阅读全文 <Icon name="material-symbols:arrow-forward-rounded"/></span></div></a>)}</div>
 </section>
 <section aria-labelledby="home-courses">
  <div class="home-section-heading"><h2 id="home-courses">课程主题</h2><a href="/notes/">查看全部主题 <Icon name="material-symbols:arrow-forward-rounded"/></a></div>
  <nav class="home-course-topics" aria-labelledby="home-courses">
   {courseTopics.map(topic=><a href={topicUrl(topic.id)} class="home-course-topic">
    <Icon name={topic.icon} aria-hidden="true"/>
    <span><strong>{topic.title}</strong><small>{topic.count} 篇</small></span><span class="home-topic-arrow" aria-hidden="true">↗</span>
   </a>)}
  </nav>
 </section>

</div>
