---
import { getNotes,getNoteTopics,getAlgorithmCategories,categoryUrl,topicUrl } from '../../utils/notes';
import WidgetLayout from './WidgetLayout.astro';
const notes=await getNotes();
const algorithmGroups=getAlgorithmCategories(notes);
const topics=getNoteTopics(notes);
interface Props { class?: string; style?: string; }
---
<WidgetLayout name="笔记分类" id="categories" class={Astro.props.class} style={Astro.props.style}>
 <nav class="study-categories" aria-label="按主题浏览笔记">
  {topics.map(topic=><div>
   <a href={topicUrl(topic.id)}><span>{topic.title}</span><small>{topic.count}</small></a>
   {topic.id==='algorithms'&&<div class="study-subcategories">
    {algorithmGroups.map(c=><a href={categoryUrl(c.name)}><span>{c.name}</span><small>{c.count}</small></a>)}
   </div>}
  </div>)}
 </nav>
</WidgetLayout>
