---
import { getNotes,getNoteTagCounts,tagUrl } from '../../utils/notes';
import WidgetLayout from './WidgetLayout.astro';
const tags=getNoteTagCounts(await getNotes()).filter(t=>t.name!=='期末复习'&&t.name!=='算法竞赛');
interface Props { class?: string; style?: string; }
---
<WidgetLayout name="主题标签" id="tags" class={Astro.props.class} style={Astro.props.style}>
 <div class="study-tags">{tags.map(tag=><a href={tagUrl(tag.name)} aria-label={`${tag.name}，${tag.count} 篇笔记`}>{tag.name}<small>{tag.count}</small></a>)}</div>
</WidgetLayout>
